<hibernate-mapping>
    <class name="datos.refactor.User" table="user">
        <id name="id" column="id">
            <generator class="increment"/>
        </id>
        <property name="username" column="username"/>
        <property name="password" column="password"/>
        <one-to-one name="contact" class="datos.refactor.Contact" cascade="all"/>

        <joined-subclass name="datos.refactor.Client" table="client">
            <key column="id"/>
            <property name="name" column="name"/>
            <property name="lastName" column="last_name"/>
            <property name="dni" column="dni"/>
            <list name="appointments" inverse="true" cascade="all">
                <key column="client_id"/>
                <list-index column="order_index"/>
                <one-to-many class="datos.refactor.Appointment"/>
            </list>
        </joined-subclass>

        <joined-subclass name="datos.refactor.Professional" table="professional">
            <key column="id"/>
            <property name="name" column="name"/>
            <property name="lastName" column="last_name"/>
            <property name="cuil" column="cuil"/>
            <set name="specialties" inverse="true" cascade="all">
                <key column="professional_id"/>
                <one-to-many class="datos.refactor.ProfessionalSpecialty"/>
            </set>
            <set name="services" inverse="true" cascade="all">
                <key column="professional_id"/>
                <one-to-many class="datos.refactor.ProfessionalService"/>
            </set>
        </joined-subclass>

    </class>
</hibernate-mapping>