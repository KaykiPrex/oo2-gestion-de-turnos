<hibernate-mapping>
    <class name="datos.refactor.Specialty" table="specialty">
        <id name="id" column="id">
            <generator class="increment"/>
        </id>
        <property name="name" column="name"/>
        <property name="description" column="description"/>
        <many-to-one name="category" class="datos.refactor.Category" column="category_id"/>
        <set name="professionalSpecialties" inverse="true" cascade="all">
            <key column="specialty_id"/>
            <one-to-many class="datos.refactor.ProfessionalSpecialty"/>
        </set>
        <set name="services" inverse="true" cascade="all">
            <key column="specialty_id"/>
            <one-to-many class="datos.refactor.Service"/>
        </set>
    </class>
</hibernate-mapping>