<hibernate-mapping>
    <class name="datos.refactor.Category" table="category">
        <id name="id" column="id">
            <generator class="increment"/>
        </id>
        <property name="name" column="name"/>
        <set name="specialties" inverse="true" cascade="all">
            <key column="category_id"/>
            <one-to-many class="datos.refactor.Specialty"/>
        </set>
    </class>
</hibernate-mapping>