<hibernate-mapping>
    <class name="datos.refactor.Appointment" table="appointment">
        <id name="id" column="id">
            <generator class="increment"/>
        </id>
        <property name="date" column="date"/>
        <property name="time" column="time"/>
        <property name="isBlocked" column="is_blocked"/>
        <property name="location" column="location"/>
        <property name="report" column="report"/>

        <many-to-one name="client" class="datos.refactor.Client" column="client_id"/>
        <many-to-one name="professionalService" class="datos.refactor.ProfessionalService" column="professional_service_id"/>
    </class>
</hibernate-mapping>