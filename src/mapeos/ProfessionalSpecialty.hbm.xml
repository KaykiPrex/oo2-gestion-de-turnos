<hibernate-mapping>
    <class name="datos.refactor.ProfessionalSpecialty" table="professional_specialty">
        <id name="id" column="id">
            <generator class="increment"/>
        </id>
        <property name="status" column="status"/>
        <many-to-one name="professional" class="datos.refactor.User" column="professional_id"/>
        <many-to-one name="specialty" class="datos.refactor.Specialty" column="specialty_id"/>
    </class>
</hibernate-mapping>